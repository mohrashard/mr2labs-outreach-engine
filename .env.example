# ==============================================================================
# MR² Labs Outreach Engine — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env.local and fill in your actual credentials.
# Do NOT commit .env.local to version control!

# ------------------------------------------------------------------------------
# 1. Email Delivery (Resend)
# ------------------------------------------------------------------------------
# Primary transactional & cold outbound provider (migrated from Brevo to avoid IP issues)
RESEND_API_KEY=re_your_resend_api_key_here
SENDER_EMAIL=growth@yourdomain.com
SENDER_NAME="Your Name"
BCC_EMAIL=your-inbox@yourdomain.com
RESEND_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 2. Database & Auth (Supabase)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# ------------------------------------------------------------------------------
# 3. Background Message Queue (Upstash QStash)
# ------------------------------------------------------------------------------
# Decouples scraping, enrichment, and pitch generation from Vercel's serverless timeout
QSTASH_URL=https://qstash-us-east-1.upstash.io
QSTASH_TOKEN=your_upstash_qstash_token
QSTASH_CURRENT_SIGNING_KEY=sig_your_qstash_current_signing_key
QSTASH_NEXT_SIGNING_KEY=sig_your_qstash_next_signing_key

# ------------------------------------------------------------------------------
# 4. Multi-Tier AI Waterfall (LLM Pitch & Audit Generation)
# ------------------------------------------------------------------------------
# Tier 1 (Primary): Ultra-fast inference with LLaMA 3.3 70B (Free tier: 30 RPM)
GROQ_API_KEY=gsk_your_groq_api_key

# Tier 2 - Tier 5 Fallback Providers
OPEN_ROUTER_API_KEY=sk-or-v1-your_openrouter_key
GEMINI_API_KEY=your_google_gemini_api_key
MISTRAL_API_KEY=your_mistral_api_key
DEEPSEEK_API_KEY=sk-your_deepseek_api_key

# ------------------------------------------------------------------------------
# 5. Search Engine & SERP Dorking Discovery
# ------------------------------------------------------------------------------
# Comma-separated API keys supported for automatic key rotation & rate limit avoidance
SERPER_API_KEY=your_serper_key_1,your_serper_key_2
SERP_API=your_serpapi_key_1,your_serpapi_key_2
SERP_API_FALLBACK=your_serpapi_fallback_key
VALUE_SERP_API=your_valueserp_key_1,your_valueserp_key_2
VALUE_SERP_API_FALLBACK=your_valueserp_fallback_key
SCRAPER_API=your_scraperapi_key
FIRECRAWL_API=fc-your_firecrawl_api_key

# ------------------------------------------------------------------------------
# 6. Waterfall Lead & Contact Enrichment
# ------------------------------------------------------------------------------
APOLLO_KEY=your_apollo_api_key
PROSPEO_API=pk_your_prospeo_api_key
HUNTER_API_KEY=your_hunter_key_1,your_hunter_key_2
SNOV_USER_ID=your_snov_user_id
SNOV_API=your_snov_api_key
ANY_MAIL_FINDER=your_anymailfinder_api_key

# ------------------------------------------------------------------------------
# 7. Email Verification & Quality Gate
# ------------------------------------------------------------------------------
VERIFALIA_EMAIL=your-verifalia-account@domain.com
VERIFALIA_PW=your_verifalia_password
VERIFY_MY_EMAIL=your_verify_my_email_api_key
EMAIL_AWESOME=your_email_awesome_api_key

# ------------------------------------------------------------------------------
# 8. Technical Performance & SEO Audit
# ------------------------------------------------------------------------------
GOOGLE_PAGESPEED_API_KEY=your_google_pagespeed_api_key

# ------------------------------------------------------------------------------
# 9. Security, Crons & Webhooks
# ------------------------------------------------------------------------------
# Secret token to protect daily automated cron endpoints (e.g. /api/cron/daily-outreach)
CRON_SECRET=generate_a_secure_random_cron_secret
NEXT_PUBLIC_CRON_SECRET=generate_a_secure_random_cron_secret
WEBHOOK_SECRET=generate_a_secure_random_webhook_secret

# ------------------------------------------------------------------------------
# 10. Application Hostnames & Portfolio Branding
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://outreach.yourdomain.com
NEXT_PUBLIC_PORTFOLIO_URL=https://www.yourdomain.com
